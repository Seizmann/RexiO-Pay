# RexiO Pay — env template. Real values live in SECRETS.md (gitignored) / Vercel / VPS env stores.
# Copy to the app's .env.local / .env and fill in. NEVER commit real values.

# apps/web
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=https://api.pay.rexio.pro
NEXT_PUBLIC_R2_PUBLIC_URL=

# apps/backend
APP_ENV=production
PORT=8080
DATABASE_URL=
APP_URL=https://pay.rexio.pro
WEBHOOK_SIGNING_DEFAULT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=rexio-pay-assets
R2_PUBLIC_URL=
SESSION_TTL_MINUTES=30
CLAIM_WINDOW_MINUTES=10
# 32-byte (64 hex chars) AES-256-GCM key for device secret encryption; rotate = all devices must re-pair
DEVICE_SECRET_ENCRYPTION_KEY=
# MFS OTP onboarding: platform's own MFS number + the merchant ID of the platform verification device account
PLATFORM_VERIFICATION_NUMBER=
PLATFORM_DEVICE_MERCHANT_ID=

# apps/android (apps/android/local.properties)
# rexio.serverUrl=https://api.pay.rexio.pro
